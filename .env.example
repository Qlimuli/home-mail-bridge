# === Pflicht für sicheren Betrieb ===
GUI_TOKEN=bitte-hier-einen-sehr-langen-zufaelligen-token-mindestens-32-zeichen

# Optional, aber empfohlen (sonst wird beim ersten Start ein Key in data/master.key erzeugt)
# 64 Hex-Zeichen = 32 Byte:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=

# Optional: fester Flask-Session-Key
GUI_SECRET=

TZ=Europe/Berlin
SYNC_INTERVAL=300
